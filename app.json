{
  "expo": {
    "name": "troBar",
    "slug": "trobar-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trobar.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aquesta app necessita la teva ubicació per trobar bars a prop.",
        "NSPhotoLibraryUsageDescription": "Aquesta app necessita accés a la teva galeria per canviar la foto de perfil.",
        "NSCameraUsageDescription": "Aquesta app necessita accés a la teva càmera per fer fotos de perfil."
      }
    },
    "android": {
      "package": "com.trobar.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJDfdnUcgcc_AUyXPnEdHStmuNsUAZtb0"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app necessita accés a les teves fotos per actualitzar el perfil."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/img/logo/LOGO_blanc.png",
          "resizeMode": "contain",
          "backgroundColor": "#a50044"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "trobar",
    "extra": {
      "eas": {
        "projectId": "d855540d-65e2-4f80-a58d-cff638387276"
      }
    },
    "owner": "frolestis-team"
  }
}
