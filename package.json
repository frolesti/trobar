{
  "name": "trobar-rn",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/devStart.js",
    "start:iphone": "powershell -ExecutionPolicy Bypass -File scripts/startIphone.ps1",
    "start:dry-run": "node scripts/devStart.js --dry-run",
    "start:raw": "expo start --offline",
    "env:dev": "node scripts/loadEnv.js dev",
    "env:prod": "node scripts/loadEnv.js prod",
    "android": "expo run:android",
    "android:emu": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant debug",
    "android:emu:fast": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant debug -SkipBuild",
    "android:emu:qa": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant debug -Gpu angle_indirect -RamMb 4096",
    "android:emu:release": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant release",
    "android:emu:fresh": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant debug -RestartEmulator -CleanInstall",
    "android:emu:release:fresh": "powershell -ExecutionPolicy Bypass -File scripts/runAndroid.ps1 -Variant release -RestartEmulator -CleanInstall",
    "ios:build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:build:production": "npx eas-cli@latest build --platform ios --profile production",
    "ios:submit:production": "npx eas-cli@latest submit --platform ios --profile production",
    "ios": "expo run:ios",
    "update-matches": "node scripts/updateMatches.js",
    "db:migrate": "node firestore/migrate.js",
    "db:migrate:status": "node firestore/migrate.js --status",
    "db:migrate:dry-run": "node firestore/migrate.js --dry-run",
    "db:validate": "node firestore/validate.js",
    "db:seed-premium": "node scripts/seedPremiumBars.js"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/oi": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/stack": "^6.4.1",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-location": "~57.0.18",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "^20.1.2",
    "@react-native-community/cli-platform-android": "^20.1.2",
    "@react-native/metro-config": "^0.84.1",
    "@types/google.maps": "^3.64.0",
    "@types/react": "~19.2.4",
    "@types/supercluster": "^7.1.3",
    "babel-preset-expo": "~57.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.4",
    "expo-module-scripts": "^5.0.8",
    "typescript": "~6.0.3",
    "wait-on": "^9.0.3"
  },
  "private": true
}
