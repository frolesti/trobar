{
  "compilerOptions": {
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "esnext"
    ],
    "resolveJsonModule": true,
    "typeRoots": [
      "./app/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "app/**/*"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "web-build",
    "dist"
  ],
  "extends": "./node_modules/expo/tsconfig.base.json"
}