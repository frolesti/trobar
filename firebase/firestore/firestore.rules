rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bars collection
    match /bars/{barId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Anyone can report that a place shows Barça, without creating an account.
      // Anonymous creation is restricted to minimal, inactive OSM reports.
      allow create: if request.auth == null
        && barId.matches('^osm_[0-9]+$')
        && request.resource.data.keys().hasAll([
          'name', 'location', 'address', 'amenities', 'source', 'createdAt',
          'isActive', 'isOpen', 'rating', 'usuallyShowsBarca', 'broadcastingMatches'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'location', 'address', 'amenities', 'source', 'createdAt',
          'isActive', 'isOpen', 'rating', 'usuallyShowsBarca', 'broadcastingMatches'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.location is map
        && request.resource.data.location.keys().hasOnly(['latitude', 'longitude'])
        && request.resource.data.location.keys().hasAll(['latitude', 'longitude'])
        && request.resource.data.location.latitude is number
        && request.resource.data.location.latitude >= -90
        && request.resource.data.location.latitude <= 90
        && request.resource.data.location.longitude is number
        && request.resource.data.location.longitude >= -180
        && request.resource.data.location.longitude <= 180
        && request.resource.data.address == ''
        && request.resource.data.amenities is list
        && request.resource.data.amenities.size() <= 30
        && request.resource.data.source == 'user_reported'
        && request.resource.data.createdAt == request.time
        && request.resource.data.isActive == false
        && request.resource.data.isOpen == true
        && request.resource.data.rating == 0
        && request.resource.data.usuallyShowsBarca == true
        && request.resource.data.broadcastingMatches is list
        && request.resource.data.broadcastingMatches.size() == 0;

      // An unauthenticated report may only turn this public flag on. It cannot
      // modify ownership, status, payments, broadcast schedules or other fields.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuallyShowsBarca'])
        && request.resource.data.usuallyShowsBarca == true;
    }

    // Bar owners
    match /barOwners/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      match /pushDevices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 256
          && request.resource.data.token.matches('^(ExponentPushToken|ExpoPushToken)\\[[A-Za-z0-9_-]+\\]$')
          && request.resource.data.updatedAt == request.time
          && request.resource.data.platform in ['ios', 'android'];
      }
      match /notificationPrivate/{documentId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && documentId == 'area'
          && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'consent', 'updatedAt'])
          && request.resource.data.consent == 'foreground'
          && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
